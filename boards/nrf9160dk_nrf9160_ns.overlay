#include <zephyr/dt-bindings/sensor/icm42688.h>

/ {
	chosen {
		zephyr,canbus = &mcp2515;
	};

	aliases {
		golioth-led = &led2;
		click-uart = &arduino_serial;
		gnss7-sel = &gnss7_sel;
	};

	gpio_logic {
		compatible = "gpio-leds";
		gnss7_sel: gnss7_sel {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; /* AN */
		};
	};
};

&arduino_serial {
	status = "okay";
	current-speed = <38400>;
};

&arduino_spi {
	status = "okay";
	/* Index in cs-gpios corresponds to the child node's reg value
	 * (see dts/bindings/spi/spi-controller.yaml) — index 0 (D10) is
	 * the existing MCP2515 CS, index 1 (D9) is the new ICM-42688-P CS. */
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>, /* CS: MCP2515 */
		   <&gpio0 9 GPIO_ACTIVE_LOW>;  /* CS: ICM-42688-P */

	mcp2515: mcp2515@0 {
		compatible = "microchip,mcp2515";
		spi-max-frequency = <1000000>;
		int-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; /* INT */
		status = "okay";
		reg = <0x0>;
		osc-freq = <10000000>;
		bitrate = <500000>;
		sample-point = <875>;

		can-transceiver {
			max-bitrate = <1000000>;
		};
	};

	/* Zephyr's mainline icm42688 driver is SPI-only (no I2C backend),
	 * hence it living on &arduino_spi rather than &arduino_i2c despite
	 * the shield exposing both. Polled via sensor_sample_fetch() from
	 * imu_icm42688.c rather than interrupt/trigger mode, so no
	 * int-gpios — one less pin to wire, and this workload doesn't need
	 * the latency interrupt mode buys. */
	icm42688: icm42688@1 {
		compatible = "invensense,icm42688";
		spi-max-frequency = <1000000>;
		status = "okay";
		reg = <0x1>;
		accel-pwr-mode = <ICM42688_DT_ACCEL_LN>;
		accel-odr = <ICM42688_DT_ACCEL_ODR_100>;
		accel-fs = <ICM42688_DT_ACCEL_FS_8>;
		gyro-pwr-mode = <ICM42688_DT_GYRO_LN>;
		gyro-odr = <ICM42688_DT_GYRO_ODR_100>;
		gyro-fs = <ICM42688_DT_GYRO_FS_2000>;
	};
};

&pinctrl {
	/*
	 * Arduino Uno provides the same SCL/SDA on two sets of pins, but the
	 * nRF9160-DK maps these pins to two different pairs of GPIO. When using
	 * the Arduino Uno Click Shield board, the P0.18/P0.19 pair must be used.
	 */
	i2c2_default: i2c2_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
				<NRF_PSEL(TWIM_SCL, 0, 19)>;
		};
	};

	i2c2_sleep: i2c2_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 18)>,
				<NRF_PSEL(TWIM_SCL, 0, 19)>;
			low-power-enable;
		};
	};

	/*
	 * The default pin group includes RTS/CTS HW flow control, but the Arduino
	 * Uno Click Shield board does not connect these pins (only TX/RX are used).
	 * This keeps RX/TX on the same pins, but just removes RTS/CTS from the
	 * pin groups.
	 */
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 1)>,
				<NRF_PSEL(UART_RX, 0, 0)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 1)>,
				<NRF_PSEL(UART_RX, 0, 0)>;
			low-power-enable;
		};
	};
};
